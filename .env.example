# ─────────────────────────────────────────────────────────────
# MT5 Trade Journal — namunaviy config. Nusxa oling: .env.example -> .env
# .env fayl git'ga TUSHMAYDI (.gitignore). Parollarni faqat shu yerga yozing.
# ─────────────────────────────────────────────────────────────

# ── MT5 ulanish ──
# Bo'sh qoldirsangiz, allaqachon ochiq bo'lgan MT5 terminaliga ulanadi (tavsiya).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# MT5 terminal.exe yo'li (ixtiyoriy, avtomatik topolmasa):
MT5_TERMINAL_PATH=

# ── Umumiy ──
TIMEZONE=Asia/Tashkent
POLL_INTERVAL_SECONDS=5
# Ishga tushganda oxirgi necha kunlik tarixni tekshirsin (backfill emas, faqat dedup uchun):
LOOKBACK_DAYS=7

# ── Sink'lar (qaysi biriga yozilsin) ──
ENABLE_EXCEL=true
ENABLE_GOOGLE_SHEETS=true
ENABLE_CSV=false

# ── Excel ──
EXCEL_PATH=data/trades.xlsx

# ── Google Sheets ──
# Service account JSON fayl yo'li:
GOOGLE_CREDENTIALS_PATH=config/credentials/service_account.json
# Google Sheet ID (URL dagi /d/<BU_QISM>/edit):
GOOGLE_SHEET_ID=
# Varaq nomlari:
SHEET_TRADES=Trades
SHEET_OPEN=Open_Positions

# ── Telegram bildirishnoma (ixtiyoriy) ──
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
